{
  "name": "schoolhub-backend",
  "version": "1.0.0",
  "description": "SchoolHub Backend API",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "start:container": "node -e \"const fs=require('fs');const path=require('path');const dir='prisma/migrations';if(!fs.existsSync(dir)||!fs.readdirSync(dir).some(name=>fs.existsSync(path.join(dir,name,'migration.sql')))){console.error('ERROR: No Prisma migrations are checked in. Create and commit an initial migration before production deployment.');process.exit(1)}\" && prisma migrate deploy && node dist/src/server.js",
    "start:local": "prisma db push && node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "lint": "tsc --noEmit",
    "test": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@types/jsonwebtoken": "^9.0.10",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/socket.io": "^3.0.1",
    "@types/uuid": "^10.0.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2"
  }
}
