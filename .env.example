# Shared / Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=schoolhub_pass
POSTGRES_DB=schoolhub
DATABASE_URL=postgresql://postgres:schoolhub_pass@postgres:5432/schoolhub?schema=public
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=schoolhub-dev-secret
NODE_ENV=development

# Backend runtime
BACKEND_PORT=4000
FIREBASE_PROJECT_ID=schoolhub-demo
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Frontend runtime
VITE_API_URL=http://localhost:4000/api/v1
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=schoolhub-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=schoolhub-demo
VITE_FIREBASE_STORAGE_BUCKET=schoolhub-demo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcd1234efgh5678

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@schoolhub.dev
PGADMIN_DEFAULT_PASSWORD=admin123

# Azure DevOps / Deployment
AZURE_VM_SSH_HOST=
AZURE_VM_SSH_USER=azureuser
AZURE_VM_SSH_KEY_PATH=~/.ssh/id_rsa
DOCKER_REGISTRY=schoolhubdev
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=
