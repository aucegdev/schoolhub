# SchoolHub Environment Variables
# Copy this to .env.local (development) or use as reference for .env.production

# ============================================
# DATABASE
# ============================================
# Local Docker Compose derives its in-container DATABASE_URL from these values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=schoolhub_pass
POSTGRES_DB=schoolhub
HTTP_PORT=3000
POSTGRES_PORT=5432

# Local: postgresql://postgres:schoolhub_pass@localhost:5432/schoolhub?schema=public
# Production: postgresql://postgres:schoolhub_pass@postgres:5432/schoolhub?schema=public
DATABASE_URL=

# ============================================
# BACKEND SERVER
# ============================================
PORT=4000

# Local: http://localhost:3000
# Production: http://localhost (nginx frontend on same origin) or https://yourdomain.com
FRONTEND_URL=

# Use a strong secret in production!
JWT_SECRET=

# ============================================
# ENVIRONMENT MODE
# ============================================
# Local containerized stack: production
# Production: production
NODE_ENV=

# ============================================
# FIREBASE ADMIN SDK (Backend)
# ============================================
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# For local Docker, use FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY, or mount
# a service-account JSON file and set GOOGLE_APPLICATION_CREDENTIALS to its
# in-container path. Never put service-account credentials in VITE_* values.

# ============================================
# FRONTEND (Vite)
# ============================================
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ============================================
# PgAdmin (Local Dev Only)
# ============================================
PGADMIN_DEFAULT_EMAIL=admin@schoolhub.dev
PGADMIN_DEFAULT_PASSWORD=admin123

# ============================================
# AZURE DEVOPS / DEPLOYMENT
# ============================================
AZURE_VM_SSH_HOST=
AZURE_VM_SSH_USER=azureuser
AZURE_VM_SSH_KEY_PATH=~/.ssh/id_rsa

DOCKER_REGISTRY=schoolhubdev
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=
