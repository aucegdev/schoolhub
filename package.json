{
  "name": "schoolhub-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SchoolHub — Smart School Management System Monorepo Workspace",
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "lint:backend": "npm run lint --prefix backend",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d",
    "docker:down": "docker compose down",
    "verify:devops": "./scripts/verify-devops-deployment.sh"
  },
  "keywords": [
    "schoolhub",
    "school-management",
    "react",
    "node",
    "express",
    "prisma",
    "docker",
    "threejs"
  ],
  "author": "Antigravity",
  "license": "ISC"
}
